const express = require("express");
const app = express();

app.use(express.json());

let orders = [];

// Save order
app.post("/order", (req, res) => {
  const order = req.body;
  orders.push(order);
  res.json({ message: "Order saved!", order });
});

// Get all orders
app.get("/orders", (req, res) => {
  res.json(orders);
});

app.listen(3000, () => {
  console.log("Server running on port 3000");
});
